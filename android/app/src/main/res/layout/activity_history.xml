<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pageBg"
    android:orientation="vertical">

    <!-- 标题栏（与主页同风格）：返回 + 标题 + 右侧清空 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/colorPrimary"
        android:paddingLeft="8dp"
        android:paddingRight="12dp">

        <TextView
            android:id="@+id/hisBack"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="←"
            android:textColor="#ffffff"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/hisBack"
            android:text="@string/history_page_title"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hisClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="6dp"
            android:text="@string/history_clear"
            android:textColor="#ffffff"
            android:textSize="14sp" />
    </RelativeLayout>

    <!-- 筛选行：全部/病虫害/杂草/综合（代码动态生成 chip） -->
    <LinearLayout
        android:id="@+id/hisFilterRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cardBg"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingTop="8dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/hisList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp" />

    </ScrollView>

    <TextView
        android:id="@+id/hisEmpty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/history_page_empty"
        android:textColor="@color/textSub"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
